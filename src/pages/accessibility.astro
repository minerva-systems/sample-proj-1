---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="w-full">
    <section class="py-12 md:py-16 bg-white">
      <div class="mx-auto max-w-3xl px-4">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-3">
          Accessibility Statement
        </h1>
        <p class="text-gray-600 mb-10">Last updated: February 2026</p>

        <div class="prose prose-gray max-w-none">
          <p>
            Harumi Sushi &amp; Hibachi is committed to making our website accessible to
            as many people as possible, including people with disabilities.
          </p>

          <h2>Our Approach</h2>
          <p>
            We aim to follow best practices for accessible design, including readable text,
            clear navigation, and support for keyboard and screen-reader use where possible.
          </p>

          <h2>Feedback</h2>
          <p>
            If you encounter any accessibility barriers on this site, please let us know so
            we can improve. Call us at <a href="tel:+19162466777">(916) 246-6777</a>.
          </p>

          <h2>Third-Party Content</h2>
          <p>
            Some features (such as embedded maps or external links) may be provided by
            third parties and may not fully meet accessibility standards.
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>

