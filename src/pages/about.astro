---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="w-full">
    <section class="py-12 md:py-16 bg-white">
      <div class="mx-auto max-w-3xl px-4">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-3">
          About Us
        </h1>
        <p class="text-gray-600 mb-10">
          Harumi Sushi &amp; Hibachi • Natomas, Sacramento
        </p>

        <div class="prose prose-gray max-w-none">
          <p>
            Harumi Sushi &amp; Hibachi is your neighborhood spot for all-you-can-eat sushi
            and hibachi in a relaxed dine-in setting. We focus on fresh ingredients, bold
            flavors, and a welcoming experience for families, friends, and celebrations.
          </p>
          <p>
            Whether you’re here for classics or chef specials, our team is happy to serve
            you. Visit us in Natomas or call ahead with questions.
          </p>

          <p>
            Phone: <a href="tel:+19162466777">(916) 246-6777</a>
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>

