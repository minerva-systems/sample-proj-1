---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="w-full">
    <section class="py-12 md:py-16 bg-white">
      <div class="mx-auto max-w-3xl px-4">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-3">
          Privacy Policy
        </h1>
        <p class="text-gray-600 mb-10">Last updated: February 2026</p>

        <div class="prose prose-gray max-w-none">
          <p>
            Harumi Sushi &amp; Hibachi respects your privacy. This page explains what
            information may be collected when you visit our website and how it may be used.
          </p>

          <h2>Information We Collect</h2>
          <ul>
            <li>
              <strong>Basic usage data</strong>: like pages visited and approximate device /
              browser information (if analytics are enabled).
            </li>
            <li>
              <strong>Information you provide</strong>: for example, if you contact us by
              phone or through a linked platform.
            </li>
          </ul>

          <h2>How We Use Information</h2>
          <p>
            We use information to operate the site, improve content, and understand how the
            website is used. We do not sell your personal information.
          </p>

          <h2>Third-Party Services</h2>
          <p>
            Our website may link to third-party services (such as Google Maps or Instagram).
            Those services may collect data according to their own policies.
          </p>

          <h2>Cookies</h2>
          <p>
            Some third-party tools may use cookies or similar technologies. You can control
            cookies in your browser settings.
          </p>

          <h2>Contact</h2>
          <p>
            Questions about this policy? Call us at <a href="tel:+19162466777">(916) 246-6777</a>.
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>

